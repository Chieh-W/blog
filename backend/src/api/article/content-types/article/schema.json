{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Technical blog articles consumed by the Next.js frontend"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "tags": {
      "type": "json"
    },
    "content": {
      "type": "richtext"
    }
  }
}
